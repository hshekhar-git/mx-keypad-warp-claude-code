<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Loupedeck.ClaudeDeckPlugin</RootNamespace>
    <AssemblyName>ClaudeDeckPlugin</AssemblyName>
    <WarningLevel>4</WarningLevel>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>

    <PluginApiDir>/Applications/Utilities/LogiPluginService.app/Contents/MonoBundle/</PluginApiDir>
    <PluginDir>$(HOME)/Library/Application Support/Logi/LogiPluginService/Plugins/</PluginDir>

    <BaseOutputPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\bin\'))</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)\bin\</OutputPath>

    <PluginShortName>ClaudeDeck</PluginShortName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- PluginApi.dll must never be copied into the output: the service refuses to load a plugin
       that ships its own copy. -->
  <ItemGroup>
    <Reference Include="PluginApi">
      <HintPath>$(PluginApiDir)PluginApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The native app watcher travels beside the DLL. Rebuilt only when its source changes. -->
  <Target Name="BuildHelper" AfterTargets="PostBuildEvent"
          Inputs="$(MSBuildThisFileDirectory)../../helper/deck-apps.swift" Outputs="$(OutputPath)deck-apps">
    <Exec Command="/usr/bin/swiftc -O &quot;$(MSBuildThisFileDirectory)../../helper/deck-apps.swift&quot; -o &quot;$(OutputPath)deck-apps&quot;" />
  </Target>

  <Target Name="CopyPackage" AfterTargets="BuildHelper">
    <ItemGroup>
      <PackageFiles Include="package\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PackageFiles)" DestinationFolder="$(OutputPath)..\%(RecursiveDir)" />
  </Target>

  <!-- Dev install: a .link file pointing the service at the build output, then a reload. -->
  <Target Name="LinkAndReload" AfterTargets="CopyPackage" Condition="'$(NoPluginLink)' != 'true'">
    <WriteLinesToFile File="$(PluginDir)$(MSBuildProjectName).link" Lines="$(BaseOutputPath)$(Configuration)/" Overwrite="true" />
    <Message Text="Linked $(PluginDir)$(MSBuildProjectName).link" Importance="High" />
    <Exec Command="open loupedeck:plugin/$(PluginShortName)/reload" ContinueOnError="true" />
  </Target>

  <Target Name="PluginClean" AfterTargets="CoreClean">
    <Delete Files="$(PluginDir)$(MSBuildProjectName).link" />
    <RemoveDir Directories="$(OutputPath)..\" />
  </Target>

</Project>
