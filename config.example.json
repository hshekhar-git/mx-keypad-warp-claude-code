{
  // What a session tile says under the project name:
  //   "title"  - Claude Code's own title for the session, falling back to your last prompt
  //   "prompt" - always your last prompt
  //   "slug"   - the session slug Warp shows on the tab
  "label": "title",

  // "ascii": tiles move - a turning spinner and a flowing block wave while Claude works, arrows closing
  // in on a prompt, a sparkle when a turn finishes, a countdown bar on the tap-to-step keys, and a
  // little ASCII art on the empty states. "plain": none of it; a working tile shows three dots.
  "style": "ascii",

  // The gauge along the top of each tile: how full the context window is. Yellow past 80%.
  "showContext": true,

  // Window size used for the gauge. A session known to be on a 1M window (from its /model switch, or
  // from the "[1m]" on your default model) uses 1,000,000. Otherwise: matched by substring against
  // the model id, else contextWindow; and anything already past 200k is assumed to be on 1M.
  "contextWindow": 200000,
  "contextWindows": {},

  // Buzzes on an MX Master 4 (remappable per event in Options+ > Haptic feedback).
  // A turn shorter than minTurnSeconds finishing is not announced - you are still watching it.
  "haptics": { "attention": true, "done": true, "error": true, "minTurnSeconds": 20 },

  // A tone from your Mac when something stops a session: `times` of them, and then quiet.
  //   attention  it is blocked on you - a permission prompt, a question, a plan
  //   error      its turn died - an API error, or your usage limit
  //   gone       its claude process went away mid-turn - crashed, or killed
  //   done       a turn simply finishing. Off, because nothing stopped it; when on, a turn shorter
  //              than haptics.minTurnSeconds still finishes in silence
  //   times      how many tones a stop gets, up to 20; 0 for none at all
  //   every      seconds from the start of one tone to the start of the next, 0.2 to 10
  //   sound      a macOS alert sound by name - Glass, Ping, Hero, Funk, Sosumi, Submarine, Morse,
  //              Tink, Basso (/System/Library/Sounds, or your own .aiff in ~/Library/Sounds) - or
  //              the path of any audio file
  //   volume     1 plays the sound as recorded; 0.5 is quieter, 2 louder, 4 the most
  // A second session stopping while the tones are still sounding starts the count again rather than
  // ringing over them, and they stop early if the session gets going again.
  "beep": { "attention": true, "error": true, "gone": true, "done": false, "times": 4, "every": 0.7, "sound": "Glass", "volume": 1 },

  // The Sessions folder.
  //   group        "flat" - every session in one list, eight to a page
  //                "tab"  - one page per Warp tab
  //   focusOnOpen  pressing a session also brings its pane to the front (false: just open its page)
  //   usageRow     keep the list's bottom three keys for plan usage (session, weekly, and a model's
  //                weekly window or pace), leaving five session tiles a page; false gives all eight
  //                to sessions
  //   pageUsageRow the same row on a session's own page, after its keys (so on the next page), its
  //                third key being THAT session's model; false leaves it off
  "sessions": { "group": "flat", "focusOnOpen": true, "usageRow": true, "pageUsageRow": true },

  // Plan usage.
  //   perModel    while a usage key is showing (at most every five minutes) run `claude -p /usage` and
  //               read the per-model weekly window - "Current week (Fable)" - off it. No model call,
  //               no session saved. false: never run it; the third key shows pace
  //   claudePath  where claude is, if not in ~/.local/bin, /opt/homebrew/bin or /usr/local/bin
  "usage": { "perModel": true, "claudePath": "" },

  // The Model key and the Models folder.
  //   alias  typed after "/model " - an alias (opus) or a full id (claude-opus-5[1m])
  //   label  what the key shows (defaults to the alias)
  //   match  text looked for in the session's model name to tell which one is in use (defaults to alias)
  //   color  "violet" | "blue" | "coral" | "green" | "amber" | "red" | "purple"
  // Note: Claude Code's /model also saves the choice as your default for new sessions.
  "models": [
    { "label": "Fable",  "alias": "fable",  "color": "violet" },
    { "label": "Opus",   "alias": "opus",   "color": "coral"  },
    { "label": "Sonnet", "alias": "sonnet", "color": "blue"   },
    { "label": "Haiku",  "alias": "haiku",  "color": "green"  }
  ],

  // The Apps folder.
  //   pinned         bundle ids that always come first, in this order - keys you can learn
  //   hidden         bundle ids never shown
  //   order          everything else: "recent" (like Cmd-Tab), "launch" or "name"
  //   closeOnSwitch  leave the folder once you have picked, like Cmd-Tab does
  "apps": {
    "pinned": ["dev.warp.Warp-Stable"],
    "hidden": [],
    "order": "recent",
    "closeOnSwitch": true
  },

  // The command keys on every session's page, after its info and settings. Max 7; the first two fit
  // on the page's first screen, the rest are one press of the right arrow away.
  //   text    typed exactly as written (a trailing space is kept)
  //   submit  press Return afterwards. Off is for something you finish by hand: "/compact " with a
  //           trailing space and no submit lets you add your own instructions before sending
  //   key     "escape" interrupts instead of typing
  //   color   "green" | "amber" | "red" | "coral" | "purple" | "blue" | "violet", default neutral
  //   icon    drawn above the label. Left out, the key gets one for what it does (Escape, Compact,
  //           Clear, Continue, else Send); "none" is a bare label; or any name from
  //           plugin/src/package/actionicons - Allow, Apps, Models, Sessions, Usage, OpenApp, ...
  //   id      optional name of your choosing. A key you have placed from "Commands" in Options+ is
  //           remembered by its id, or without one by what it does - so relabelling never unbinds it,
  //           and with an id you can even change what it types
  // The same keys are published under "Commands" in Options+ for your home page.
  "keys": [
    { "label": "esc",      "key": "escape" },
    { "label": "/compact", "text": "/compact",  "submit": true  },
    { "label": "continue", "text": "continue", "submit": true },
    { "label": "/clear",   "text": "/clear",   "submit": false, "color": "red" }
  ]
}
